# Backend environment variables for Farmilky
# Copy to `.env` and fill with secure values.

# Express server
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<db_user>:<db_pass>@<cluster>.mongodb.net/<db_name>?retryWrites=true&w=majority

# JWT auth
JWT_SECRET=<your_jwt_secret>

# Allowed CORS origins
FRONTEND_URL=http://localhost:5173
ADMIN_PORTAL_URL=http://localhost:3000   # optional if you have separate admin frontend
BACKEND_URL=http://localhost:4000        # required for UPI tap-to-pay link in PDF invoices (set to your public backend URL in production)

# Optional local scheduler control (development only)
ENABLE_LOCAL_SCHEDULER=true

# Optional cron secret protection
CRON_SECRET=<your_cron_secret>

# UPI payment details (used for invoice QR codes)
UPI_ID=<your_upi_id>
UPI_NAME=Farmilky
